{
  "name": "Aurox Cloud VPS (Linux + Browser Desktop)",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest",
      "noVncVersion": "1.6.0",
      "password": "aurox123",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "containerEnv": {
    "VNC_RESOLUTION": "1920x1080x24"
  },
  "forwardPorts": [6080, 8000],
  "portsAttributes": {
    "6080": {
      "label": "Aurox Linux Desktop GUI (noVNC)",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Aurox Website Preview",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-vps.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
